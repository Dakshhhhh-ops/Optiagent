# Copy to .env and adjust. All backend settings use the OPTIAGENT_ prefix.
# Never commit .env — it holds secrets.

# --- AI model -------------------------------------------------------------------------------
# Local (default): Ollama on this machine.
OPTIAGENT_LLM_PROVIDER=ollama
OPTIAGENT_OLLAMA_BASE_URL=http://localhost:11434
OPTIAGENT_OLLAMA_MODEL=qwen3:8b

# Hosted: any OpenAI-compatible API. Uncomment ONE block and paste your key.
#
# Groq (https://console.groq.com/keys)
# OPTIAGENT_LLM_PROVIDER=openai
# OPTIAGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# OPTIAGENT_LLM_MODEL=qwen/qwen3-32b
# OPTIAGENT_LLM_API_KEY=gsk_...
#
# OpenRouter (https://openrouter.ai/keys)
# OPTIAGENT_LLM_PROVIDER=openai
# OPTIAGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
# OPTIAGENT_LLM_MODEL=qwen/qwen3-32b
# OPTIAGENT_LLM_API_KEY=sk-or-...
#
# Model names change over time: check the provider's model list and the Status page.

# --- Sign-in (Clerk) ------------------------------------------------------------------------
# Leave unset for local single-user mode. For a public site, create an app at
# https://dashboard.clerk.com and copy its keys (API keys page).
#
# Website (web/.env.local):
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...              # server-side only, never NEXT_PUBLIC_
#
# API: the Clerk Frontend API URL (shown next to the keys), and the site's origin.
# OPTIAGENT_AUTH_ISSUER=https://your-app.clerk.accounts.dev
# OPTIAGENT_AUTH_AUTHORIZED_PARTIES=["https://your-site.vercel.app"]

# --- Limits and logging (production) ------------------------------------------------------------
# OPTIAGENT_TRUST_PROXY=true                # behind Render / Fly
# OPTIAGENT_LLM_REQUESTS_PER_HOUR=30        # per signed-in user
# OPTIAGENT_LLM_REQUESTS_PER_DAY=2000       # whole site: caps the AI bill
# OPTIAGENT_LOG_JSON=true
# OPTIAGENT_SENTRY_DSN=https://...

# --- Database ----------------------------------------------------------------------------------
# Local SQLite by default. Production: a Postgres URL, e.g. from Neon.
# OPTIAGENT_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Services -------------------------------------------------------------------------------
OPTIAGENT_POSTGRES_HOST=localhost
OPTIAGENT_POSTGRES_PORT=5432
OPTIAGENT_REDIS_HOST=localhost
OPTIAGENT_REDIS_PORT=6379

# --- Frontend -------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
