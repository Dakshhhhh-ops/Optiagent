# Copy to .env and adjust. All backend settings use the OPTIAGENT_ prefix.
# Never commit .env — it holds secrets.

# --- AI model -------------------------------------------------------------------------------
# Local (default): Ollama on this machine.
OPTIAGENT_LLM_PROVIDER=ollama
OPTIAGENT_OLLAMA_BASE_URL=http://localhost:11434
OPTIAGENT_OLLAMA_MODEL=qwen3:8b

# Hosted: any OpenAI-compatible API. Uncomment ONE block and paste your key.
#
# Groq (https://console.groq.com/keys)
# OPTIAGENT_LLM_PROVIDER=openai
# OPTIAGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# OPTIAGENT_LLM_MODEL=qwen/qwen3-32b
# OPTIAGENT_LLM_API_KEY=gsk_...
#
# OpenRouter (https://openrouter.ai/keys)
# OPTIAGENT_LLM_PROVIDER=openai
# OPTIAGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
# OPTIAGENT_LLM_MODEL=qwen/qwen3-32b
# OPTIAGENT_LLM_API_KEY=sk-or-...
#
# Model names change over time: check the provider's model list and the Status page.

# --- Services -------------------------------------------------------------------------------
OPTIAGENT_POSTGRES_HOST=localhost
OPTIAGENT_POSTGRES_PORT=5432
OPTIAGENT_REDIS_HOST=localhost
OPTIAGENT_REDIS_PORT=6379

# --- Frontend -------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
